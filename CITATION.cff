    given-names: Jake
    affiliation: "VTT Technical Research Centre of Finland"
version: 2.5.0
date-released: 2026-11-04
license: Apache-2.0
repository-code: "https://github.com/FiQCI/QCut"
url: "https://github.com/FiQCI/QCut"
keywords:
  - quantum computing
  - circuit cutting
  - circuit knitting
  - qiskit
